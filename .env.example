# Copy to .env (never commit it). On GCP, load these from Secret Manager instead.
# Pick one LLM provider; leave others blank. With none set, the bot runs rules-only.
XAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Only needed when broker.mode is "openalgo" (live). Created in your OpenAlgo dashboard.
OPENALGO_API_KEY=
